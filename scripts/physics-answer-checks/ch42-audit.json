  "method": "Original conservation, mass-defect, exponential-decay, coordinate and dose calculations; source diagrams reviewed visually. Author script preserves all formulas.",
  "notices": [
    {
      "id": "physics-chapter-42-problems-6",
      "notice": "Figure 42-5 gives approximate daughter neutron counts; Y-89 and I-127 give 19 excess neutrons."
    },
    {
      "id": "physics-chapter-42-problems-15",
      "notice": "The pair-count statement suppresses the separate radius dependence; includingR∝A^(1/3) gives Coulomb energy scalingZ(Z−1)/A^(1/3)."
    },
    {
      "id": "physics-chapter-42-problems-17",
      "notice": "The chapter treats the initially nearly stationary capture with negligible final recoil; that approximation is used."
    },
    {
      "id": "physics-chapter-42-problems-19",
      "notice": "These are mass percentages, as the problem specifies; atom percentages are a different convention."
    },
    {
      "id": "physics-chapter-42-problems-33",
      "notice": "An estimation exercise: the numeric example uses the stated breathing assumptions. Other justified capacities or breathing rates give different valid estimates; the general relation is checked separately."
    },
    {
      "id": "physics-chapter-42-problems-38",
      "notice": "The source activity is 8.60μCi, not 8.60 mCi; the check follows the original printed micro-unit."
    },
    {
      "id": "physics-chapter-42-problems-41",
      "notice": "The source abundance is rounded; converting an atomic fraction with natural Sm mean molar mass changes the estimate by about 2%."
    },
    {
      "id": "physics-chapter-42-problems-44",
      "notice": "Graph-read half-life≈2 s; the activity is an approximate graph extrapolation."
    },
    {
      "id": "physics-chapter-42-problems-55",
      "notice": "The original source unit is micro-u, not milli-u."
    },
    {
      "id": "physics-chapter-42-problems-64",
      "notice": "Interpret the supplied 1.26 billion-year value as the total K-40 half-life. Equal partial half-lives would contradict the stated unequal branching ratio."
    },
    {
      "id": "physics-chapter-42-problems-71",
      "notice": "Uses ΔEΔt≈ħ, the chapter convention; factors of order unity depend on linewidth definition."
    },
    {
      "id": "physics-chapter-42-problems-76",
      "notice": "The original PDF has a micro-sievert prefix, not milli-sievert."
    },
    {
      "id": "physics-chapter-42-problems-79",
      "notice": "The textbook threshold is not a present-day health recommendation."
    },
    {
      "id": "physics-chapter-42-problems-80",
      "notice": "Conditional numerical estimate uses projected area 1 m²; present year 2026 and year-only 1996 origin give 30 years, not a precisely dated elapsed time."
    },
    {
      "id": "physics-chapter-42-problems-82",
      "notice": "The checks assess the defining curve, endpoint and extraction method; a freehand plot is not directly autograded."
    },
    {
      "id": "physics-chapter-42-problems-83",
      "notice": "Do not confuse h/r with ħ/r or ħ/(2 r); these give different prefactors, not contradictory exact measurements."
    },
    {
      "id": "physics-chapter-42-problems-87",
      "notice": "The graph is specified by its equation, two checked points and monotonic shape."
    },
    {
      "id": "physics-chapter-42-problems-90",
      "notice": "Official NNDC NuDat 3 output.json snapshot reviewed 2026-10-25; observed means discovery status DISCOVERED, including entries with unmeasured half-life. STABLE is the dataset classification, not a claim that every theoretically allowed decay is impossible."
    },
    {
      "id": "physics-chapter-42-problems-94",
      "notice": "The phrase stability zone is a broad chart trend here. Ac-227 and Pu-239 are radioactive and should not be labeled stable."
    },
    {
      "id": "physics-chapter-42-problems-96",
      "notice": "Pb-210 half-life is 22.6 years; the diagram prefix is a source typo, not a 22.6-thousand-year decay."
    },
    {
      "id": "physics-chapter-42-questions-10",
      "notice": "The smooth binding curve supports the intended average-binding ranking 2>3>1. Exact neutron or proton removal energies require adjacent masses."
    }
